{
  "version": "2.0.0",
  "tasks": [
    {
      // O compose vive no diretório pai, junto dos três repos.
      "label": "api: só o banco",
      "type": "shell",
      "command": "docker compose up -d --wait db 2>&1 | tail -3; docker compose stop api 2>&1 | tail -1; echo 'banco pronto'",
      "options": { "cwd": "${workspaceFolder}/.." },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "api: testes",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "api: nova migration",
      "type": "shell",
      "command": "npx prisma migrate dev",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "api: prisma studio",
      "type": "shell",
      "command": "npx prisma studio",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
